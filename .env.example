# MongoDB Atlas connection string.
# Get this from Atlas → Database → Connect → "Drivers", then paste it below
# and swap in your real username/password/database name.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rare-scents?retryWrites=true&w=majority
MONGODB_URI=

# NextAuth.js — random secret used to sign/encrypt admin session JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=
# Base URL NextAuth uses for callbacks. http://localhost:3000 in dev;
# use your production domain (https://www.therarescents.com) in production.
NEXTAUTH_URL=http://localhost:3000

# Google Search Console — paste the "content" value from the HTML-tag
# verification method (meta name="google-site-verification"). Optional.
GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Optional.
# Prefixed with NEXT_PUBLIC_ so the client-side gtag script can read it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
